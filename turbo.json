{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "env": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_MODEL",
        "DATABASE_URL",
        "NEXT_PUBLIC_APP_URL",
        "RATE_LIMIT_PER_MINUTE",
        "ML_SERVICE_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["ANTHROPIC_API_KEY", "DATABASE_URL", "ML_SERVICE_URL"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"]
    }
  }
}
