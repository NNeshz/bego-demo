{
  "name": "bego-retorno",
  "private": true,
  "description": "Unofficial concept: return-load copilot for owner-operator truckers. Not affiliated with BeGo.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate && pnpm db:seed",
    "db:generate": "pnpm --filter @retorno/db db:generate",
    "db:migrate": "pnpm --filter @retorno/db db:migrate",
    "db:seed": "pnpm --filter @retorno/db db:seed",
    "db:studio": "pnpm --filter @retorno/db db:studio",
    "ai:smoke": "pnpm --filter @retorno/ai smoke"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
