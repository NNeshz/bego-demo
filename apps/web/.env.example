# Copy to .env.local. Every value is optional: the app runs in fallback mode without them.

# Claude API (trip parsing + explanations). Without it: rule-based parser + templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Postgres. Without it: deterministic in-memory seed.
#   Local (Docker):  pnpm db:up && pnpm db:migrate && pnpm db:seed
#   Production:      a Neon URL (…neon.tech) automatically uses the serverless HTTP driver.
DATABASE_URL=postgresql://retorno:retorno@localhost:54329/retorno

NEXT_PUBLIC_APP_URL=http://localhost:3100

# AI-backed requests per client per minute (default 20).
RATE_LIMIT_PER_MINUTE=20

# services/ml: learned ranking weights. Without it: hand-set weights.
ML_SERVICE_URL=http://localhost:8100
# Read by services/ml only (never by the web app): required to retrain over HTTP from /modelo.
ML_ADMIN_TOKEN=
